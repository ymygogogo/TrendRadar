[Unit]
Description=TrendRadar repository runner on the PVE CI VM
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/trendradar-ci/ci-runner.sh run
ExecStop=-/usr/bin/docker rm -f trendradar-runtime-pve
Restart=always
RestartSec=7
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
