[Unit]
Description=TrendRadar repository runner on the PVE CI VM
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/trendradar-ci/ci-runner.sh run
ExecStop=/opt/trendradar-ci/ci-runner.sh stop
Restart=always
RestartSec=7
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
